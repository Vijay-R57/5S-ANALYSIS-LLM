VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-pub-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
PROVIDER_IMAGE_GEN="gemini"

# Gemini API (required for direct browser-side analysis when edge function is unavailable)
VITE_GEMINI_API_KEY="your-gemini-api-key"

# AI Pipeline Debug Mode — set to true to enable detailed console logging during development
# Never set this to true in production. Default: false (no-op)
VITE_AI_DEBUG=false

# Bypass Supabase Edge Functions for local offline testing (Default: false)
VITE_BYPASS_SUPABASE_FUNCTIONS=false

# Optional: Improvement Visualization Engine (IVE) - OpenAI API key
VITE_OPENAI_API_KEY=your-openai-api-key
